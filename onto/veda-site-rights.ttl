@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix v-fs: <http://semantic-machines.com/veda/veda-search/> .
@prefix v-s: <http://semantic-machines.com/veda/veda-schema/> .
@prefix v-ui: <http://semantic-machines.com/veda/veda-ui/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix d: <http://semantic-machines.com/veda/veda-data/> .
@prefix cfg: <http://semantic-machines.com/veda/config/> .
@prefix site: <http://semantic-machines.com/veda-site/> .

### RIGHTS ###

<http://semantic-machines.com/veda/veda-site-rights>
  rdf:type owl:Ontology ;
  rdfs:label "Сайт Veda. Права"@ru ;
  rdfs:label "Veda site. Rights"@en ;
#  owl:versionInfo "1.3" ;
  v-s:loadPriority 10 ;
.

### GROUPS ###

site:SiteAdmin
  rdf:type v-s:Group ;
  rdfs:label "Группа администраторов сайта"@ru ;
  rdfs:label "Site admin group"@en ;
.

### PERMISSIONS ###

# Public read access for unauthenticated visitors.
# cfg:Guest is the built-in Veda user for requests without a session ticket.
# Grants canRead on all instances of the classes used by the public site:
#   site:Article_group      — page content articles (auto-membership via cfg:Event_7)
#   site:Page_group         — page individuals (auto-membership via cfg:Event_7)
#   site:SiteFile_group     — logos, icons, images (auto-membership via cfg:Event_7)
#   site:SiteAspect_group   — aspect catalogue (auto-membership via cfg:Event_7)
#   site:SiteApplication_group — application catalogue (auto-membership via cfg:Event_7)
site:GuestReadPermission
  rdf:type v-s:PermissionStatement ;
  rdfs:label "Права на чтение для гостевого пользователя"@ru ;
  rdfs:label "Read permissions for guest user"@en ;
  v-s:permissionSubject cfg:Guest ;
  v-s:permissionObject site:Article_group, site:Page_group, site:SiteFile_group ;
  v-s:permissionObject site:SiteAspect_group, site:SiteApplication_group ;
  v-s:permissionObject site:Block_group, site:Site_group, site:NavMenu_group, site:MenuItem_group, site:BlockItem_group ;
  v-s:canRead "true"^^xsd:boolean ;
.

site:SiteAdminPermission
  rdf:type v-s:PermissionStatement ;
  rdfs:label "Полномочия группы администраторов сайта"@ru ;
  rdfs:label "Site admin group permissions"@en ;
  v-s:permissionSubject site:SiteAdmin ;
  v-s:permissionObject site:Site, site:Page, site:Block, site:BlockItem ;
  v-s:permissionObject site:NavMenu, site:MenuItem, site:SiteFile ;
  v-s:permissionObject site:SiteAspect, site:SiteApplication ;
  v-s:permissionObject site:Article, site:Category, site:Comment ;
  v-s:permissionObject site:Site_group, site:Page_group, site:Block_group, site:BlockItem_group ;
  v-s:permissionObject site:NavMenu_group, site:MenuItem_group, site:SiteFile_group ;
  v-s:permissionObject site:SiteAspect_group, site:SiteApplication_group ;
  v-s:permissionObject site:Article_group, site:Category_group ;
  v-s:canCreate "true"^^xsd:boolean ;
  v-s:canRead "true"^^xsd:boolean ;
  v-s:canUpdate "true"^^xsd:boolean ;
  v-s:canDelete "true"^^xsd:boolean ;
.
